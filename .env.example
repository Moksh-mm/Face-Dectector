# Copy to .env.local for local work; set the same names in Vercel's
# Project Settings > Environment Variables for deployment.
# Every variable here is SERVER-ONLY. None has a NEXT_PUBLIC_ prefix, so none
# is ever sent to the browser. Never commit real values.

# --- Immich -----------------------------------------------------------------

# Base URL of the Immich server, no trailing slash. It must be reachable from
# wherever this app runs: on Vercel that means a public HTTPS address.
IMMICH_URL=

# Immich API key. Needs: person.read, person.statistics, asset.read, asset.view,
# face.read. Create it under Immich > Account Settings > API Keys.
IMMICH_API_KEY=

# --- Face recognition -------------------------------------------------------

# Immich's machine-learning service (POST /predict). It has NO authentication,
# so it must never be exposed to the internet. Locally: http://127.0.0.1:3004.
IMMICH_ML_URL=

# --- Sessions and admin -----------------------------------------------------

# Signs visitor scan sessions and the admin cookie. 32+ random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs everyone out.
SESSION_SECRET=

# Password for /admin, /people and the admin APIs. 16+ random characters; in
# production, shorter values and anything starting "change-me" are refused.
ADMIN_TOKEN=

# --- Optional: sessions and storage -----------------------------------------

# How long a scan keeps working, in minutes (default 30, maximum 240).
# SCAN_SESSION_TTL_MINUTES=30

# Where the face index is stored (default: ./data). This holds face embeddings,
# so keep it private and out of version control and backups that others can read.
# FACE_INDEX_DIR=/var/lib/face-finder

# --- Optional: rate limiting -------------------------------------------------

# Recognition attempts allowed per client per window (default 10). Every attempt
# counts, successful or not, so a bad upload cannot be retried for free.
# RATE_LIMIT_RECOGNIZE_PER_MINUTE=10

# Recognition attempts allowed across ALL clients per window (default 60). This
# is the real ceiling on ML load and needs no client address to be trusted.
# RATE_LIMIT_RECOGNIZE_GLOBAL_PER_MINUTE=60

# The window both limits above are measured over, in seconds (default 60).
# RATE_LIMIT_WINDOW_SECONDS=60

# Failed admin sign-ins per client before lockout (default 5), and how long the
# lockout lasts in seconds (default 900 = 15 minutes). Successes are never
# blocked, and a correct sign-in clears the count.
# RATE_LIMIT_ADMIN_FAILURES=5
# RATE_LIMIT_ADMIN_WINDOW_SECONDS=900

# How many reverse proxies YOU control sit in front of this app. 0 (default)
# means none, and the X-Forwarded-For header is then untrusted: it is used only
# as a best-effort key, and the global limit is what actually protects the ML
# service. Set to 1 behind one proxy (nginx, Caddy, Cloudflare) so the client is
# taken from that proxy's entry and cannot be spoofed by the caller.
# TRUSTED_PROXY_HOPS=0

# --- Optional: timeouts ------------------------------------------------------

# How long to wait for Immich to start answering a request someone is waiting
# on (default 8000 ms). Short on purpose: a clear "try again" beats a hang.
# IMMICH_REQUEST_TIMEOUT_MS=8000

# The same, for the index rebuild, which nobody is waiting on (default 120000 ms).
# A busy Immich catching up on thumbnails and face detection can take 30 s or
# more to answer, and a background job should wait rather than abandon the build.
# IMMICH_BACKGROUND_TIMEOUT_MS=120000
